@namespace BackpackResizer.Pages.Components
@using BackpackResizer.Config
@using BackpackResizer.Presets
@using BackpackResizer.Utility
@using SPTarkov.Common.Models.Logging
@inject ISptLogger<PresetToolbar> Logger
@inject PresetRepository Repository

<div class="bgr-toolbar">
    <label>
        <input type="checkbox" @bind="Config.ModEnabled" @bind:after="OnConfigChanged.InvokeAsync" />
        Mod Enabled
    </label>
    <label>
        <input type="checkbox" @bind="Config.DebugLogging" @bind:after="OnConfigChanged.InvokeAsync" />
        Debug Logging
    </label>
    <input class="bgr-filter" type="text" placeholder="Filter backpacks..." value="@FilterText" @oninput="OnFilterInput" />
    <select class="bgr-preset-select" @bind="SelectedPresetKey">
        <option value="">Select a preset...</option>
        @foreach (var entry in Repository.Presets)
        {
            <option value="@entry.Key">@entry.Preset.Name</option>
        }
    </select>
    <button type="button" class="bgr-load-preset-btn bgr-btn-white" disabled="@(SelectedEntry is null)" @onclick="LoadSelectedPreset">Load Preset Values</button>

    @if (SelectedEntry is { Source: PresetSource.User })
    {
        if (_presetLoaded)
        {
            <button type="button" class="bgr-load-preset-btn bgr-btn-green" @onclick="() => _confirmingUpdate = true">Update Preset</button>
        }
        <button type="button" class="bgr-load-preset-btn bgr-btn-red" @onclick="() => _confirmingDelete = true">Delete Preset</button>
    }

    <button type="button" class="bgr-load-preset-btn bgr-btn-blue" @onclick="() => _showSavePresetForm = true">Save New Preset</button>
</div>

@* outside the flex toolbar so it can be content-width on its own row *@
@if (SelectedEntry is { } selected && (selected.Preset.Author.Length > 0 || selected.Preset.Description.Length > 0))
{
    <div class="bgr-preset-info">
        @if (selected.Preset.Author.Length > 0)
        {
            <div><strong><u>Author:</u></strong>&nbsp;@selected.Preset.Author</div>
        }
        @if (selected.Preset.Description.Length > 0)
        {
            <div><strong><u>Selected Preset Description:</u></strong>&nbsp;@selected.Preset.Description</div>
        }
    </div>
}

@if (_showSavePresetForm)
{
    <div class="bgr-modal-backdrop">
        <div class="bgr-modal" role="dialog" aria-modal="true" aria-labelledby="bgr-save-preset-title">
            <h4 id="bgr-save-preset-title" class="bgr-modal-title">Save New Preset</h4>

            <label class="bgr-modal-field">
                Name
                <input type="text" placeholder="New preset name..." @bind="_newPresetName" @bind:event="oninput" />
            </label>
            <label class="bgr-modal-field">
                Author (optional)
                <input type="text" @bind="_newPresetAuthor" @bind:event="oninput" />
            </label>
            <label class="bgr-modal-field">
                Description (optional)
                <textarea rows="3" @bind="_newPresetDescription" @bind:event="oninput"></textarea>
            </label>

            @if (_saveError is not null)
            {
                <div class="bgr-modal-error">@_saveError</div>
            }

            <div class="bgr-modal-actions">
                <button type="button" class="bgr-load-preset-btn bgr-btn-green" disabled="@string.IsNullOrWhiteSpace(_newPresetName)" @onclick="SaveAsNewPreset">Create</button>
                <button type="button" class="bgr-load-preset-btn bgr-btn-red" @onclick="CancelSavePreset">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_confirmingUpdate && SelectedEntry is { Source: PresetSource.User } presetToUpdate)
{
    <div class="bgr-modal-backdrop">
        <div class="bgr-modal" role="dialog" aria-modal="true" aria-labelledby="bgr-update-preset-title">
            <h4 id="bgr-update-preset-title" class="bgr-modal-title">Update Preset</h4>

            <p class="bgr-modal-text">Overwrite '@presetToUpdate.Preset.Name' with the current backpack sizes? This can't be undone.</p>

            <div class="bgr-modal-actions">
                <button type="button" class="bgr-load-preset-btn bgr-btn-green" @onclick="UpdateSelectedPreset">Update</button>
                <button type="button" class="bgr-load-preset-btn bgr-btn-red" @onclick="() => _confirmingUpdate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_confirmingDelete && SelectedEntry is { Source: PresetSource.User } presetToDelete)
{
    <div class="bgr-modal-backdrop">
        <div class="bgr-modal" role="dialog" aria-modal="true" aria-labelledby="bgr-delete-preset-title">
            <h4 id="bgr-delete-preset-title" class="bgr-modal-title">Delete Preset</h4>

            <p class="bgr-modal-text">Delete '@presetToDelete.Preset.Name'? This can't be undone.</p>

            <div class="bgr-modal-actions">
                <button type="button" class="bgr-load-preset-btn bgr-btn-red" @onclick="DeleteSelectedPreset">Delete</button>
                <button type="button" class="bgr-load-preset-btn bgr-btn-white" @onclick="() => _confirmingDelete = false">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModConfig Config { get; set; } = null!;

    [Parameter] public string FilterText { get; set; } = "";

    [Parameter] public EventCallback<string> FilterTextChanged { get; set; }

    [Parameter] public EventCallback<string> OnStatusMessage { get; set; }
    
    [Parameter] public EventCallback OnConfigChanged { get; set; }

    private string _selectedPresetKey = "";
    private bool _confirmingDelete;
    private bool _confirmingUpdate;

    // true once the selected preset's values were loaded; switching presets clears it
    private bool _presetLoaded;
    private bool _showSavePresetForm;
    private string _newPresetName = "";
    private string _newPresetAuthor = "";
    private string _newPresetDescription = "";
    
    private string? _saveError;

    private ColorLogger<PresetToolbar>? _log;

    // a pending delete/update confirmation, and the loaded state that unlocks update, belong to the preset
    // they were made for, not the next one picked
    private string SelectedPresetKey
    {
        get => _selectedPresetKey;
        set
        {
            if (_selectedPresetKey == value)
            {
                return;
            }

            _selectedPresetKey = value;
            _confirmingDelete = false;
            _confirmingUpdate = false;
            _presetLoaded = false;
        }
    }

    private PresetEntry? SelectedEntry => string.IsNullOrEmpty(_selectedPresetKey) ? null : Repository.Find(_selectedPresetKey);

    // rescans the presets folder each time the page opens so dropped-in files appear on refresh
    protected override async Task OnInitializedAsync()
    {
        _log = new ColorLogger<PresetToolbar>(Logger, Config);
        await Repository.ReloadAsync();
    }

    private Task OnFilterInput(ChangeEventArgs e) => FilterTextChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private async Task LoadSelectedPreset()
    {
        if (SelectedEntry is not { Preset: var preset })
        {
            return;
        }

        var (matched, unmatched) = PresetMatcher.Resolve(preset, Config.Backpacks);
        var appliedCount = 0;

        foreach (var (backpackKey, entry) in matched)
        {
            var backpack = Config.Backpacks[backpackKey];
            if (backpack.Grid is not { } gridOverride)
            {
                _log!.Debug($"preset '{preset.Name}' has an entry for '{backpack.BackpackName}' ({backpackKey}) but it can't be resized - skipped.");
                continue;
            }

            gridOverride.Width = entry.Width;
            gridOverride.Height = entry.Height;
            appliedCount++;
        }

        foreach (var entry in unmatched)
        {
            _log!.Debug($"preset '{preset.Name}' has an entry for '{entry.Name}' [{string.Join(", ", entry.ItemIds)}] that doesn't match any backpack on this install - skipped.");
        }

        _presetLoaded = true;

        var unmatchedNote = unmatched.Count > 0 ? $", {unmatched.Count} not found on this install" : "";
        await OnStatusMessage.InvokeAsync($"Loaded preset '{preset.Name}' onto {appliedCount} backpack(s){unmatchedNote} - click Save to apply.");
    }

    private async Task SaveAsNewPreset()
    {
        var name = _newPresetName.Trim();
        if (name.Length == 0)
        {
            return;
        }

        _saveError = null;

        var preset = new Preset
        {
            Name = name,
            Author = _newPresetAuthor.Trim(),
            Description = _newPresetDescription.Trim(),
            Backpacks = PresetMatcher.Capture(Config.Backpacks),
        };

        if (preset.Backpacks.Count == 0)
        {
            _saveError = "There are no resizable backpacks to save into a preset yet.";
            return;
        }

        try
        {
            SelectedPresetKey = await Repository.CreateAsync(preset);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _log!.Error($"couldn't write preset '{name}' to the presets folder.", ex);
            _saveError = $"Couldn't save preset '{name}': {ex.Message}";
            return;
        }

        CancelSavePreset();
        await OnStatusMessage.InvokeAsync($"Saved preset '{name}' as presets/{SelectedPresetKey}.");
    }

    private async Task UpdateSelectedPreset()
    {
        _confirmingUpdate = false;

        if (SelectedEntry is not { Source: PresetSource.User } entry)
        {
            return;
        }

        var updated = entry.Preset with { Backpacks = PresetMatcher.Update(entry.Preset, Config.Backpacks) };

        try
        {
            if (!await Repository.UpdateAsync(entry.Key, updated))
            {
                await OnStatusMessage.InvokeAsync($"Preset '{entry.Preset.Name}' is gone, so it couldn't be updated.");
                SelectedPresetKey = "";
                return;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _log!.Error($"couldn't update preset file '{entry.Key}'.", ex);
            await OnStatusMessage.InvokeAsync($"Couldn't update preset '{entry.Preset.Name}': {ex.Message}");
            return;
        }

        await OnStatusMessage.InvokeAsync($"Updated preset '{entry.Preset.Name}' (presets/{entry.Key}).");
    }

    private async Task DeleteSelectedPreset()
    {
        _confirmingDelete = false;

        if (SelectedEntry is not { Source: PresetSource.User } entry)
        {
            return;
        }

        try
        {
            if (!await Repository.DeleteAsync(entry.Key))
            {
                await OnStatusMessage.InvokeAsync($"Preset '{entry.Preset.Name}' was already gone.");
                SelectedPresetKey = "";
                return;
            }
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _log!.Error($"couldn't delete preset file '{entry.Key}'.", ex);
            await OnStatusMessage.InvokeAsync($"Couldn't delete preset '{entry.Preset.Name}': {ex.Message}");
            return;
        }

        SelectedPresetKey = "";
        await OnStatusMessage.InvokeAsync($"Deleted preset '{entry.Preset.Name}'.");
    }

    private void CancelSavePreset()
    {
        _showSavePresetForm = false;
        _newPresetName = "";
        _newPresetAuthor = "";
        _newPresetDescription = "";
        _saveError = null;
    }
}
